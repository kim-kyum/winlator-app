<?xml version="1.0" encoding="utf-8"?>
<!-- Winlator S11 power menu (Ctrl+Alt+Del, or Alt+F4 on the desktop): leave, restart or
     force-quit the running container. The dim backdrop cancels on click. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C000000"
    android:clickable="true"
    android:soundEffectsEnabled="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/S11PowerCard"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/s11_power_card"
        android:clickable="true"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="20dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:soundEffectsEnabled="false">

        <TextView
            android:id="@+id/S11PowerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/s11_power_title"
            android:textColor="#FF1B1B1B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:text="@string/s11_power_subtitle"
            android:textColor="#FF616161"
            android:textSize="13sp" />

        <include
            android:id="@+id/S11PowerShutdown"
            layout="@layout/s11_power_item" />

        <include
            android:id="@+id/S11PowerRestart"
            layout="@layout/s11_power_item" />

        <include
            android:id="@+id/S11PowerForce"
            layout="@layout/s11_power_item" />

        <include
            android:id="@+id/S11PowerAppMenu"
            layout="@layout/s11_power_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            android:background="#14000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:text="@string/s11_power_hint"
                android:textColor="#FF8A8A8A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/S11PowerCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/s11_power_item_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/s11_power_cancel"
                android:textColor="#FF1B1B1B"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
