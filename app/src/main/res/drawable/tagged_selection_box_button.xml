<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
            <solid android:color="?attr/s11FieldPressed" />
            <stroke android:width="1dp" android:color="?attr/s11FieldBorder" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
            <solid android:color="?attr/colorSecondarySurface" />
            <stroke android:width="1dp" android:color="?attr/s11FieldBorder" />
        </shape>
    </item>
</selector>
