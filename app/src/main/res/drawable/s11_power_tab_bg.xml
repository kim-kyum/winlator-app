<?xml version="1.0" encoding="utf-8"?>
<!-- Power tab: dark glass normally, Windows accent blue under the cursor -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF004A94" />
            <corners
                android:bottomLeftRadius="11dp"
                android:bottomRightRadius="11dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF005FB8" />
            <corners
                android:bottomLeftRadius="11dp"
                android:bottomRightRadius="11dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B81F1F1F" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <corners
                android:bottomLeftRadius="11dp"
                android:bottomRightRadius="11dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>
</selector>
