<?xml version="1.0" encoding="utf-8"?>
<!-- Winlator S11: a page in the top navigation (narrow screens) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/s11NavSelected" />
            <stroke android:width="1dp" android:color="?attr/colorAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/s11FieldPressed" />
            <stroke android:width="1dp" android:color="?attr/s11FieldBorder" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/colorSecondarySurface" />
            <stroke android:width="1dp" android:color="?attr/s11FieldBorder" />
        </shape>
    </item>
</selector>
