<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="value" format="float" />
    <attr name="minValue" format="integer|float" />
    <attr name="maxValue" format="integer|float" />
    <attr name="step" format="integer|float" />
    <attr name="textSize" format="dimension" />
    <attr name="colorPrimaryText" format="color" />
    <attr name="colorSecondaryText" format="color" />
    <attr name="colorSecondarySurface" format="color" />
    <attr name="toolboxBackground" format="reference" />
    <!-- Winlator S11: fields, cards and navigation -->
    <attr name="s11FieldBorder" format="color" />
    <attr name="s11FieldPressed" format="color" />
    <attr name="s11FieldFill" format="color" />
    <attr name="s11CardBorder" format="color" />
    <attr name="s11NavSelected" format="color" />
    <attr name="s11NeutralButton" format="color" />
    <attr name="s11NeutralButtonPressed" format="color" />
    <attr name="s11AccentPressed" format="color" />
    <declare-styleable name="NumberPicker">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="textSize" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="suffix" format="string" />
        <attr name="textSize" />
    </declare-styleable>
</resources>
