<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="tabSelectedTextColor">?attr/colorPrimaryText</item>
        <item name="tabTextColor">?attr/colorSecondaryText</item>
        <item name="android:windowBackground">?attr/colorPrimarySurface</item>
        <item name="android:colorBackground">?attr/colorPrimarySurface</item>
        <item name="android:textViewStyle">@style/TextView</item>
        <item name="android:checkboxStyle">@style/CheckBox</item>
        <item name="android:listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="android:popupWindowStyle">@style/PopupWindow</item>
        <item name="popupWindowStyle">@style/PopupWindow</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
        <item name="android:toolbarStyle">@style/Toolbar</item>
        <item name="toolbarStyle">@style/Toolbar</item>
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerDropDownItem</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:radioButtonStyle">@style/RadioButton</item>
        <item name="radioButtonStyle">@style/RadioButton</item>
    </style>
    <!-- Winlator S11: neutral greys and Samsung's One UI blue; flat surfaces (the window, the
         toolbar and the status bar share one colour) and plain white or grey cards -->
    <style name="AppThemeLightColors" parent="@style/AppThemeBase">
        <item name="colorAccent">#0381fe</item>
        <item name="colorPrimary">#f6f6f6</item>
        <item name="colorPrimaryDark">#f6f6f6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#f6f6f6</item>
        <item name="colorControlNormal">#767676</item>
        <item name="colorPrimaryText">#111111</item>
        <item name="colorSecondaryText">#707070</item>
        <item name="colorPrimarySurface">#f6f6f6</item>
        <item name="colorSecondarySurface">#ffffff</item>
        <item name="colorPrimaryVariant">#767676</item>
        <item name="colorSecondaryVariant">#e3e3e3</item>
        <item name="colorError">#e5484d</item>
        <item name="s11FieldBorder">#d6d6d6</item>
        <item name="s11FieldFill">#f1f1f1</item>
        <item name="s11FieldPressed">#e6e6e6</item>
        <item name="s11CardBorder">#ebebeb</item>
        <item name="s11NavSelected">#e8e8e8</item>
        <item name="s11NeutralButton">#ececec</item>
        <item name="s11NeutralButtonPressed">#dddddd</item>
        <item name="s11AccentPressed">#006ad6</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_light</item>
        <item name="toolboxBackground">@drawable/toolbox_light</item>
        <item name="panelBackground">@drawable/panel_background_light</item>
    </style>
    <style name="AppThemeLight" parent="@style/AppThemeLightColors" />
    <style name="AppThemeDark" parent="@style/AppThemeBase">
        <item name="colorAccent">#3e91ff</item>
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorControlNormal">#8f8f8f</item>
        <item name="colorPrimaryText">#f2f2f2</item>
        <item name="colorSecondaryText">#939393</item>
        <item name="colorPrimarySurface">#000000</item>
        <item name="colorSecondarySurface">#1b1b1b</item>
        <item name="colorPrimaryVariant">#8f8f8f</item>
        <item name="colorSecondaryVariant">#2c2c2c</item>
        <item name="colorError">#ff5a5f</item>
        <item name="s11FieldBorder">#3a3a3a</item>
        <item name="s11FieldFill">#262626</item>
        <item name="s11FieldPressed">#303030</item>
        <item name="s11CardBorder">#2a2a2a</item>
        <item name="s11NavSelected">#262626</item>
        <item name="s11NeutralButton">#2b2b2b</item>
        <item name="s11NeutralButtonPressed">#363636</item>
        <item name="s11AccentPressed">#2f7ae0</item>
        <item name="popupMenuBackground">@drawable/content_dialog_background_dark</item>
        <item name="toolboxBackground">@drawable/toolbox_dark</item>
        <item name="panelBackground">@drawable/panel_background_dark</item>
    </style>
    <style name="AppThemeFullscreenLight" parent="@style/AppThemeLight">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="AppThemeFullscreenDark" parent="@style/AppThemeDark">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="ComboBox">
        <item name="android:layout_width">192dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:background">@drawable/combo_box</item>
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
    </style>
    <style name="MultiSelectionComboBox">
        <item name="android:layout_width">192dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/combo_box</item>
    </style>
    <style name="SpinnerDropDownItem" parent="@android:style/Widget.Holo.DropDownItem.Spinner">
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="ListPopupWindow" parent="@android:style/Widget.ListPopupWindow">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>
    <style name="PopupWindow" parent="@android:style/Widget.PopupWindow">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>
    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">?attr/popupMenuBackground</item>
    </style>
    <style name="ContentDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">?attr/popupMenuBackground</item>
    </style>
    <style name="EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:textColorHint">?attr/colorSecondaryText</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/edit_text</item>
    </style>
    <style name="TextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="CheckBox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="RadioButton" parent="@android:style/Widget.CompoundButton.RadioButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:paddingRight">8dp</item>
    </style>
    <style name="TitleTextAppearance" parent="android:TextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="Toolbar" parent="@android:style/Widget.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorPrimaryText</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TitleTextAppearance</item>
    </style>
    <style name="BaseButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="ButtonNeutral" parent="BaseButton">
        <item name="android:background">@drawable/button_neutral</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>
    <style name="ButtonPositive" parent="BaseButton">
        <item name="android:background">@drawable/button_positive</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>
    <!-- Winlator S11: a button that is only its text, as in One UI's dialogs -->
    <style name="ButtonText" parent="BaseButton">
        <item name="android:background">@drawable/s11_text_button</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minWidth">88dp</item>
    </style>
    <!-- Winlator S11: the drawer (the app's pages, the menu of a running container) -->
    <style name="S11NavigationView">
        <item name="android:background">?attr/colorPrimarySurface</item>
        <item name="itemIconTint">@color/s11_nav_item_icon</item>
        <item name="itemTextColor">@color/s11_nav_item_text</item>
        <item name="itemTextAppearance">@style/S11NavText</item>
        <item name="itemShapeFillColor">@color/s11_nav_item_fill</item>
        <item name="itemShapeAppearance">@style/S11NavShape</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
        <item name="itemShapeInsetTop">2dp</item>
        <item name="itemShapeInsetBottom">2dp</item>
        <item name="itemHorizontalPadding">28dp</item>
        <item name="itemIconPadding">20dp</item>
        <item name="itemIconSize">22dp</item>
    </style>
    <style name="S11NavText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="S11NavShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="BaseImageButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="ToolButton" parent="BaseImageButton">
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:tint">?attr/colorPrimaryVariant</item>
    </style>
    <style name="ListMenuButton" parent="BaseImageButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:tint">?attr/colorPrimaryVariant</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
    </style>
    <style name="VerticalLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
    </style>
    <style name="HorizontalLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="FieldSet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bordered_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingTop">50dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="FieldSetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginLeft">20dp</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>
    <style name="TableHead">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="TableHeadRightLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">#0278b8</item>
    </style>
    <style name="TableHeadBottomLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#0278b8</item>
    </style>
    <style name="TableBodyRightLine">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorControlNormal</item>
    </style>
    <style name="HelpButton">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:src">@drawable/icon_help</item>
        <item name="tint">#e0e0e0</item>
    </style>
    <style name="Toolbox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/toolboxBackground</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
    <style name="LeftSideButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="tint">?attr/colorPrimaryVariant</item>
        <item name="android:background">@drawable/left_side_button</item>
        <item name="android:padding">6dp</item>
    </style>
    <style name="RightSideButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="tint">?attr/colorPrimaryVariant</item>
        <item name="android:background">@drawable/right_side_button</item>
        <item name="android:padding">6dp</item>
    </style>
    <!-- Winlator S11: settings pages (container settings) -->
    <style name="S11SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="S11GroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorSecondaryText</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginLeft">4dp</item>
    </style>
    <style name="S11Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/s11_card</item>
    </style>
    <style name="S11Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="S11RowStacked" parent="S11Row">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">left</item>
    </style>
    <style name="S11RowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="S11RowTextStacked">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="S11RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
    </style>
    <style name="S11RowDescription">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorSecondaryText</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="S11RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/s11CardBorder</item>
        <item name="android:layout_marginLeft">20dp</item>
    </style>
    <style name="S11NavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:background">@drawable/s11_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="S11Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorPrimaryText</item>
        <item name="android:background">@drawable/s11_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
