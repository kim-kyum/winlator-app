#include <windows.h>

#pragma code_page(65001)

1 ICON "s11shell.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "s11shell.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Winlator S11"
            VALUE "FileDescription", "Winlator S11 taskbar and start menu"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "s11shell"
            VALUE "OriginalFilename", "s11shell.exe"
            VALUE "ProductName", "Winlator S11"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
